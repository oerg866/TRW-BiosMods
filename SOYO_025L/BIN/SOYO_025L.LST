				    ; Remove HD presets to create space for PS/2 code
				    include ..\__scripts\nohdtable.inc
			      C ; Include this file to remove the HDD preset parameter table suport.
			      C ; The BIOS' menu itself will be modified accordingly.
			      C ; Results in a free ~500 byte code cave.
			      C ; (C) 2026 Eric Voirin
			      C 
			      C 
			      C     MESSAGE NOHDTABLE, 'Removing HDD Preset Table'
			      C 
			      C     PATCH_CODE_START
 6413			     1C     SEG_15 SEGMENT USE16 PARA PUBLIC 'CODE'
			      C 
			      C ; We put the strings for the menu override here
			      C     ORG offset HDD_PresetTable
			      C 
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Strings for 4.5x and 6.xx respectively
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C 
			      C IF BIOS_VERSION LT 5000h
 = 'None'		      C STR_None EQU 'None'
 = 'Auto'		      C STR_Auto EQU 'Auto'
 = 'User'		      C STR_User EQU 'User'
			      C ELSE
			      C ENDIF
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Preset entry count, seems like Auto is its own preset??
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C 
			      C IFDEF BIOS_SupportsAutoDetect
			      C ELSE
 = 002F			      C PRESET_COUNT EQU 47
			      C ENDIF
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; New item entries for HDD param table for each drive
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C 
 E401 4E 6F 6E 65 00	      C HDDC_Items  db STR_None, 0
 E406  002F [		      C             db PRESET_COUNT dup (1)
        01
       ]
			      C 
			      C IFDEF BIOS_SupportsAutoDetect
			      C ENDIF
 E435  01		      C             db 1
 E436  55 73 65 72 00	      C             db STR_User, 0
			      C 
 E43B 4E 6F 6E 65 00	      C HDDD_Items  db STR_None, 0
 E440  002F [		      C             db PRESET_COUNT dup (1)
        01
       ]
			      C IFDEF BIOS_SupportsAutoDetect
			      C ENDIF
 E46F  55 73 65 72 00	      C             db STR_User, 0
 E474  01		      C             db 1
			      C 
			      C IFDEF BIOS_SupportsDualChannel
			      C 
			      C     MESSAGE NOHDTABLE, 'This BIOS supports dual IDE channels.'
			      C 
 E475 4E 6F 6E 65 00	      C HDDE_Items  db STR_None, 0
 E47A  002F [		      C             db PRESET_COUNT dup (1)
        01
       ]
			      C IFDEF BIOS_SupportsAutoDetect
			      C ENDIF
 E4A9  01		      C             db 1
 E4AA  01		      C             db 1
 E4AB  01		      C             db 1
 E4AC  55 73 65 72 00	      C             db STR_User, 0
			      C 
 E4B1 4E 6F 6E 65 00	      C HDDF_Items  db STR_None, 0
 E4B6  002F [		      C             db PRESET_COUNT dup (1)
        01
       ]
			      C IFDEF BIOS_SupportsAutoDetect
			      C ENDIF
 E4E5  01		      C             db 1
 E4E6  01		      C             db 1
 E4E7  55 73 65 72 00	      C             db STR_User, 0
 E4EC			      C 
			      C ENDIF ; BIOS_SupportsDualChannel
			      C 
			      C ; The free Code Cave:tm: starts here
 = E4EC			      C CODECAVE_HDDParams = $
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Menu item overrides
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C HDD_MenuItem_Override MACRO where, newItems
			      C     ORG (where)
			      C     dw 0000000000000b   ; Remove key-in and number showing support
			      C     ORG (where) + 11
			      C     dw offset newItems  ; Point string item selection to the table we made
			      C     ENDM
			      C 
			      C     HDD_MenuItem_Override Menuitem_HDD_C, HDDC_Items
 4AB4  0000		     1C     dw 0000000000000b   ; Remove key-in and number showing support
 4ABF  E401 R		     1C     dw offset HDDC_Items  ; Point string item selection to the table we made
			      C     HDD_MenuItem_Override Menuitem_HDD_D, HDDD_Items
 4B7C  0000		     1C     dw 0000000000000b   ; Remove key-in and number showing support
 4B87  E43B R		     1C     dw offset HDDD_Items  ; Point string item selection to the table we made
			      C 
			      C IFDEF BIOS_SupportsDualChannel
			      C     HDD_MenuItem_Override Menuitem_HDD_E, HDDE_Items
 4C44  0000		     1C     dw 0000000000000b   ; Remove key-in and number showing support
 4C4F  E475 R		     1C     dw offset HDDE_Items  ; Point string item selection to the table we made
			      C     HDD_MenuItem_Override Menuitem_HDD_F, HDDF_Items
 4D0C  0000		     1C     dw 0000000000000b   ; Remove key-in and number showing support
 4D17  E4B1 R		     1C     dw offset HDDF_Items  ; Point string item selection to the table we made
			      C ENDIF
			      C 
			      C     PATCH_CODE_END
 4D19			     1C     SEG_15 ENDS
			      C 

				    ; Add PS2 Mouse Support
				    include ..\__scripts\mouse.inc
			      C ; Mouse Handler Implementation
			      C ; To add mouse support to old BIOSes
			      C ; Original code by AWARD software
			      C ; Modifications by oerg866
			      C 
 = 0022			      C Mouse_FarCallOffset     EQU 22h
 = 0024			      C Mouse_FarCallSegment    EQU 24h
 = 0026			      C Mouse_CountIndex        EQU 26h
 = 0027			      C Mouse_PacketSizeFlags   EQU 27h     ; Packet Size and Flags
 = 0080			      C Mouse_DriverFarCallFlag EQU 080h    ; ^ Bit 7 set = Device Driver Far Call routine is set
 = 0028			      C Mouse_AuxData           EQU 28h     ; 28 - 2F Mouse Aux Data Buffer
			      C 
			      C ; KBC Aux/Mouse Return Codes
 = 00AA			      C KBC_Aux_Code_SelfTestOK EQU 0AAh
 = 00FE			      C KBC_Aux_Code_Resend     EQU 0FEh
 = 00FA			      C KBC_Aux_Code_Ack        EQU 0FAh
 = 00FC			      C KBC_Aux_Code_Error      EQU 0FCh
			      C 
			      C ; KBC Aux/Mouse Command Codes
 = 00E6			      C Cmd_ResetScaling        EQU 0E6h
 = 00E7			      C Cmd_SetScaling          EQU 0E7h
 = 00E8			      C Cmd_SetResolution       EQU 0E8h
 = 00E9			      C Cmd_StatusRequest       EQU 0E9h
 = 00EA			      C Cmd_SetStreamMode       EQU 0EAh
 = 00EB			      C Cmd_ReadData            EQU 0EBh
 = 00EC			      C Cmd_ResetWrapMode       EQU 0ECh
 = 00EE			      C Cmd_SetWrapMode         EQU 0EEh
 = 00F0			      C Cmd_SetRemoteMode       EQU 0F0h
 = 00F2			      C Cmd_ReadDeviceType      EQU 0F2h
 = 00F3			      C Cmd_SetSamplingRate     EQU 0F3h
 = 00F4			      C Cmd_EnableData          EQU 0F4h
 = 00F5			      C Cmd_DisableData         EQU 0F5h
 = 00F6			      C Cmd_SetDefault          EQU 0F6h
 = 00FE			      C Cmd_Resend              EQU 0FEh
 = 00FF			      C Cmd_Reset               EQU 0FFh
			      C 
 = 0060			      C KBC_WriteCMD            EQU 60h
			      C 
 = 0000			      C Int15h_AH_Success               EQU 00h
 = 0001			      C Int15h_AH_InvalidFunction       EQU 01h
 = 0002			      C Int15h_AH_InvalidInput          EQU 02h
 = 0003			      C Int15h_AH_InterfaceError        EQU 03h
 = 0004			      C Int15h_AH_Resend                EQU 04h
 = 0005			      C Int15h_AH_NoFarCallInstalled    EQU 05h
			      C 
			      C ; Int15h Function C2 Stack Frame (INPUT)
 = byte ptr [bp+10h]	      C Int15h_C2_BP_SubFunction    EQU byte ptr [bp+10h] ; al
 = byte ptr [bp+0fh]	      C Int15h_C2_BP_Command        EQU byte ptr [bp+0fh] ; bh
 = word ptr [bp+02h]	      C Int15h_C2_BP_Segment        EQU word ptr [bp+02h] ; es
 = word ptr [bp+0eh]	      C Int15h_C2_BP_Offset         EQU word ptr [bp+0eh] ; bx
			      C ; Int15h Function C2 Stack Frame (OUTPUT)
 = word ptr [bp+16h]	      C Int15h_C2_BP_Flags          EQU word ptr [bp+16h]
 = byte ptr [bp+11h]	      C Int15h_C2_BP_Error          EQU byte ptr [bp+11h] ; ah
 = byte ptr [bp+0fh]	      C Int15h_C2_BP_bh             EQU byte ptr [bp+0fh] ; bh
 = byte ptr [bp+0eh]	      C Int15h_C2_BP_bl             EQU byte ptr [bp+0eh] ; bl
 = byte ptr [bp+0ch]	      C Int15h_C2_BP_cl             EQU byte ptr [bp+0ch] ; cl
 = byte ptr [bp+0ah]	      C Int15h_C2_BP_dl             EQU byte ptr [bp+0ah] ; dl
			      C 
			      C 
			      C     MESSAGE MOUSE, 'Adding PS/2 Support'
			      C 
 4D19			      C SEG_15 SEGMENT USE16 PARA PUBLIC 'CODE'
			      C 
			      C     org offset CODECAVE_HDDParams
			      C 
 E4EC			      C IRQ12_New:
			      C ;;    push ax
			      C ;;    push bx
			      C ;;    push cx
			      C ;;    push si
			      C ;;    push di
			      C ;;    push bp
 E4EC  60		      C     pusha
 E4ED  1E		      C     push ds
 E4EE  06		      C     push es
 E4EF  FC		      C     cld
 E4F0  E4 60		      C     in al, KBC_DataPort
 E4F2  FB		      C     sti
			      C 
 E4F3  E8 0096		      C     call getXBDASegmentIntoDS
			      C     assume ds:nothing   ; <-- why?
			      C 
 E4F6  8A 1E 0026	      C     mov bl, ds:Mouse_CountIndex
 E4FA  80 26 0026 F8	      C     and byte ptr ds:Mouse_CountIndex, 0f8h  ; Clear count index
 E4FF  32 FF		      C     xor bh, bh
 E501  80 E3 07		      C     and bl, 7
			      C 
			      C     ; Set mouse data
 E504  88 47 28		      C     mov ds:Mouse_AuxData[bx], al
			      C     ; Get packet size
 E507  8A 3E 0027	      C     mov bh, ds:Mouse_PacketSizeFlags
 E50B  80 E7 07		      C     and bh, 7
			      C     ; If complete packet was received, do a far call
 E50E  FE C3		      C     inc bl
 E510  38 FB		      C     cmp bl, bh
 E512  77 35		      C     ja IRQ12_DoFarCall
			      C     ; If not, set new Count Index
 E514  08 1E 0026	      C     or ds:Mouse_CountIndex, bl
			      C     
			      C     ; Check data packet
			      C     ; !!! This used to be a separate function, but this is the only caller
			      C     ; !!! and older BIOSes infact had this inline, so we save 4 bytes.
 E518			      C Mouse_CheckDataPacket:
			      C     ; Loop count
 E518  B9 00A5		      C     mov cx, 5*33
 E51B			      C Mouse_CheckDataPacket_Loop:
 E51B  E4 64		      C     in al, 64h
			      C     IODELAY
 E51D  EB 00		     1C     jmp short $+2
 E51F  EB 00		     1C     jmp short $+2
 E521  FB		      C     sti
			      C     ; TODO - Check what status code is being checked here
			      C     ; Is KBC ready?
 E522  24 21		      C     and al, 21h
 E524  3C 21		      C     cmp al, 21h ; '!'
 E526  74 1F		      C     jz short Mouse_CheckDataPacket_End
 E528  51		      C     push cx
 E529  53		      C     push bx
 E52A  B9 0001		      C     mov cx, 1
 E52D  33 DB		      C     xor bx, bx
 E52F  E8 089A		      C     call Wait_Refresh
 E532  5B		      C     pop bx
 E533  59		      C     pop cx
 E534  E2 E5		      C     loop Mouse_CheckDataPacket_Loop
			      C 
 E536  80 26 0026 F8	      C     and byte ptr ds:Mouse_CountIndex, 0f8h
 E53B  1E		      C     push ds
 E53C  07		      C     pop es
			      C     assume es:nothing
 E53D  FC		      C     cld
			      C 
			      C ; Clear aux data buffer
 E53E  BF 0028		      C     mov di, offset Mouse_AuxData
 E541  33 C0		      C     xor ax, ax
 E543  AB		      C     stosw
 E544  AB		      C     stosw
 E545  AB		      C     stosw
 E546  AB		      C     stosw
			      C 
 E547			      C Mouse_CheckDataPacket_End:
			      C     ; End the interrupt
 E547  EB 36		      C     jmp short IRQ12_Exit
			      C 
			      C     ; Do far call for mouse driver
 E549			      C IRQ12_DoFarCall:
			      C     ; If a mouse driver routine isn't installed, get out
 E549  F6 06 0027 80	      C     test byte ptr ds:Mouse_PacketSizeFlags, Mouse_DriverFarCallFlag
 E54E  74 2F		      C     jz short IRQ12_Exit
			      C 
			      C     ; Put packet size into bx
 E550  86 DF		      C     xchg bl, bh
 E552  32 FF		      C     xor bh, bh
			      C     ; Prepare loop
 E554  8B CB		      C     mov cx, bx
 E556  41		      C     inc cx
			      C     ; Get Translation Table Address for our packet size
 E557  8B F3		      C     mov si, bx
 E559  D1 E6		      C     shl si, 1
 E55B  8D 1E 0071 R	      C     lea bx, cs:PacketSizeTable
 E55F  2E: 8B 18	      C     mov bx, word ptr cs:[bx+si]
			      C 
			      C     ; Set and clear stack
 E562  33 C0		      C     xor ax, ax
 E564  50		      C     push ax
 E565  50		      C     push ax
 E566  50		      C     push ax
 E567  50		      C     push ax
 E568  8B EC		      C     mov bp, sp
 E56A  BE 0028		      C     mov si, Mouse_AuxData
			      C 
 E56D			      C IRQ12_SetStackLoop:
			      C     ; Get stack relative position
 E56D  2E: 8A 07	      C     mov al, cs:[bx]
 E570  8B F8		      C     mov di, ax
			      C     ; Get mouse data and store it in stack
 E572  AC		      C     lodsb
 E573  88 03		      C     mov [bp+di], al
 E575  43		      C     inc bx
 E576  E2 F5		      C     loop IRQ12_SetStackLoop
			      C     ; Call driver service
 E578  FF 1E 0022	      C     call dword ptr ds:Mouse_FarCallOffset
 E57C  83 C4 08		      C     add sp, 8
			      C 
 E57F			      C IRQ12_Exit:
			      C     ; End of interrupt
 E57F  FA		      C     cli
 E580  B0 20		      C     mov al, 20h
 E582  E6 A0		      C     out 0a0h, al
 E584  E7 E1		      C     out 0e1h, ax
 E586  E6 20		      C     out 020h, al
 E588  07		      C     pop es
 E589  1F		      C     pop ds
			      C ;;    pop bp
			      C ;;    pop di
			      C ;;    pop si
			      C ;;    pop cx
			      C ;;    pop bx
			      C ;;    pop ax
 E58A  61		      C     popa
 E58B  CF		      C     iret
			      C 
 E58C			      C GetXBDASegmentIntoDS:
 E58C  6A 40		      C     push Bios_RAM_Segment
 E58E  1F		      C     pop ds
 E58F  FF 36 000E	      C     push [word ptr ds:RAM_ExtData_Segment_ID]
 E593  1F		      C     pop ds
 E594  C3		      C     retn
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15 Handler Code
			      C 
 E595			      C Int15h_MouseFunction:
			      C ;;; [o866] I think this may be an archaic leftover and we can just assume this
			      C ;;; so get rid of it
			      C ;;    ; this checks for "wait for external event supported" - whatever that is
			      C ;;    test cs:Sys_BiosConfigTable+5, 4
			      C ;;    jnz short Int15h_MouseFunction_Process
			      C ;;    jmp Int15h_ContinueProcessing
			      C ;;Int15h_MouseFunction_Process:
			      C 
			      C     ; Check if mouse present
 E595  06		      C     push es
 E596  6A 40		      C     push Bios_RAM_Segment
 E598  07		      C     pop es
			      C     assume es:nothing
 E599  26: F6 06 0010 04      C     test byte ptr es:RAM_Bios_Hardware, 4
 E59F  07		      C     pop es
			      C     assume es:nothing
			      C     ; Mouse not present, go back to int15 main path
			      C     _JZ Int15h_ContinueProcessing
 E5A0  0F 84		     1C     db 0fh, 084h
 E5A2  F3A1		     1C     dw (offset Int15h_ContinueProcessing)-$-2
			      C 
 E5A4			      C Int15h_MousePresent:
			      C 
			      C     ; Build a stack frame
 E5A4  50		      C     push ax   ; [bp+10]
 E5A5  53		      C     push bx   ; [bp+0e]
 E5A6  51		      C     push cx   ; [bp+0c]
 E5A7  52		      C     push dx   ; [bp+0a]
 E5A8  56		      C     push si   ; [bp+08]
 E5A9  57		      C     push di   ; [bp+06]
 E5AA  1E		      C     push ds   ; [bp+04]
 E5AB  06		      C     push es   ; [bp+02]
 E5AC  55		      C     push bp   ; [bp+00]
 E5AD  8B EC		      C     mov bp, sp
			      C 
			      C     ; Disable Aux output buffer full (AOBF) interrupt
			      C     ; we dont need DX, so we can use it to store AL which gets clobbered in DisableAOBFIrq
 E5AF  8B D0		      C     mov dx, ax
 E5B1  E8 0106		      C     call DisableAOBFIrq
			      C 
			      C     ; Data segment for the C2 handler is the XBDA
 E5B4  E8 FFD5		      C     call GetXBDASegmentIntoDS
			      C 
			      C     ; Since we moved AX into DX earlier, the function from AH ended up in DH...
 E5B7  80 FE C1		      C     cmp dh, 0C1h
 E5BA  75 05		      C     jnz short Int15h_C2_Handler
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h Function C1 Handler - Get Extended Data Segment
			      C ; Outputs XBDA segment in ES and leaves the interrupt outright
 E5BC			      C Int15h_C1_Handler:
			      C     ; The XBDA segment is already in DS, just move it to ES on the stack frame
			      C     ; to have it returned to the caller
 E5BC  8C 5E 02		      C     mov Int15h_C2_BP_Segment, ds
 E5BF  EB 30		      C     jmp short Int15h_C1_Exit
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h Function C2 Handler - Pointing Device Interface
 E5C1			      C Int15h_C2_Handler:
 E5C1  F6 C2 F8		      C     test dl, 0f8h
 E5C4  75 10		      C     jnz short Int15h_C2_InvalidFunctionError
			      C 
			      C     ; Get handler offset for this subfunction from table and jump to it
 E5C6  BE 0040 R	      C     mov si, offset Int15h_C2_SubFunctionTable
 E5C9  32 F6		      C     xor dh, dh
 E5CB  D1 E2		      C     shl dx, 1
 E5CD  03 F2		      C     add si, dx
 E5CF  2E: FF 24	      C     jmp word ptr cs:[si]
			      C 
			      C ; Error handling
 E5D2			      C Int15h_C2_Success:
			      C     ; Set flags on stack frame for success and
			      C     ; the return code in AL we put on the stack frame later
 E5D2  33 C0		      C     xor ax, ax
 E5D4  EB 10		      C     jmp short Int15h_C2_Exit
 E5D6			      C Int15h_C2_InvalidFunctionError:
			      C ;;    mov Int15h_C2_BP_Error, Int15h_AH_InvalidFunction
 E5D6  B0 01		      C     mov al, Int15h_AH_InvalidFunction
 E5D8  EB 0A		      C     jmp short Int15h_C2_ErrorExit
 E5DA			      C Int15h_C2_InvalidInputError:
			      C ;;    mov Int15h_C2_BP_Error, Int15h_AH_InvalidInput
 E5DA  B0 02		      C     mov al, Int15h_AH_InvalidInput
 E5DC  EB 06		      C     jmp short Int15h_C2_ErrorExit
 E5DE			      C Int15h_C2_InterfaceError:
			      C ;;    mov Int15h_C2_BP_Error, Int15h_AH_InterfaceError
 E5DE  B0 03		      C     mov al, Int15h_AH_InterfaceError
 E5E0  EB 02		      C     jmp short Int15h_C2_ErrorExit
 E5E2			      C Int15h_C2_NoFarCallInstalledError:
			      C ;;    mov Int15h_C2_BP_Error, Int15h_AH_NoFarCallInstalled
 E5E2  B0 05		      C     mov al, Int15h_AH_NoFarCallInstalled
 E5E4			      C Int15h_C2_ErrorExit:
			      C     ; Set carry flag in stack frame
 E5E4  B4 01		      C     mov ah, 01h
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int 15h / C2 EXIT path
			      C ; Expects RETURN CODE for error on stack frame in AL
			      C ; Expects FLAGS for flags on stack frame in AH (!!!)
 E5E6			      C Int15h_C2_Exit:
 E5E6  88 46 11		      C     mov Int15h_C2_BP_Error, al
 E5E9  81 66 16 00FE	      C     and Int15h_C2_BP_Flags, 0FEh
 E5EE  08 66 16		      C     or byte ptr Int15h_C2_BP_Flags, ah
			      C 
 E5F1			      C Int15h_C1_Exit:
			      C     ; Re-Enable AOBF IRQ
 E5F1  E8 00D2		      C     call EnableAOBFIrq
			      C     ; Restore stack & exit
 E5F4  5D		      C     pop bp
 E5F5  07		      C     pop es
 E5F6  1F		      C     pop ds
 E5F7  5F		      C     pop di
 E5F8  5E		      C     pop si
 E5F9  5A		      C     pop dx
 E5FA  59		      C     pop cx
 E5FB  5B		      C     pop bx
 E5FC  58		      C     pop ax
 E5FD  CF		      C     iret
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 0: Enable/Disable mouse
			      C ;; DISREGARD THIS -> bh: 0 = disable, 1 = enable
			      C ; bh nonzero = enable, 0 = disable
			      C ; This is a deviation from original AWD bios but much smaller
			      C ; cf: 0 = no error, 1 = error
 E5FE			      C Int15h_C2_EnableDisableMouse:
 E5FE  F6 06 0027 80	      C     test byte ptr ds:Mouse_PacketSizeFlags, Mouse_DriverFarCallFlag
 E603  74 DD		      C     jz short Int15h_C2_NoFarCallInstalledError
			      C     ;; AL F4h / BH 1 = enable
 E605  B0 F4		      C     mov al, Cmd_EnableData
 E607  0A FF		      C     or bh, bh
			      C     ;; BH 1 = enable --> skip setting AL to disable command
 E609  75 02		      C     jnz short Int15h_C2_EnableDisableMouse_NotDisable
 E60B  FE C0		      C     inc al ; al is now "disable mouse" command
			      C     ; fallthrough
			      C 
 E60D			      C Int15h_C2_EnableDisableMouse_NotDisable:
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ;; Code path  jump point for sending a byte out and waiting for ack
			      C ;; and then taking C2 exit path
 E60D			      C Int15h_C2_SendByteWaitAckAndExit:
 E60D  E8 1A22		      C     call Out_8042_Aux_And_WaitAck_NoReturnOnError
 E610  EB D4		      C     jmp short Int15h_C2_Exit
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 1: Reset Pointing Device
			      C ; cf: 0 = no error, 1 = error
 E612			      C Int15h_C2_ResetMouse:
			      C     ; clear mouse packet buffer before sending
 E612  32 FF		      C     xor bh, bh ; Reset mouse command resets packet size in OG funcition
 E614  B2 01		      C     mov dl, 1
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Code path jump point for RESETTING THE MOUSE and SETTING THE PACKET SIZE
			      C ; bh = Packet size
			      C ; DX = 1 - store returned ID in stack frame's BX
			      C ;      0 - don't store result in stack frame's BX
 E616			      C Int15h_C2_ResetMouse_Execute:
			      C     ; Set packet size to given value
 E616  BE 0027		      C     mov si, Mouse_PacketSizeFlags
 E619  80 24 F8		      C     and byte ptr ds:[si], 0f8h
 E61C  08 3C		      C     or byte ptr ds:[si], bh
			      C 
			      C     ; Number of (re)tries
 E61E  B3 0A		      C     mov bl, 10
 E620			      C Int15h_C2_ResetMouse_TryLoop:
			      C     ; Send "reset" command to the mouse
 E620  B0 FF		      C     mov al, Cmd_Reset
 E622  E8 F2AF		      C     call Out_8042_Aux
			      C 
			      C     ; Sending command failed - I/F error
 E625  75 B7		      C     jnz short Int15h_C2_InterfaceError
			      C 
			      C     ; Wait for Ack
 E627  E8 19D6		      C     call Int15h_C2_WaitAck
			      C     ; Ack received? Success, leave the try-loop
 E62A  74 06		      C     jz short Int15h_C2_ResetMouse_GetID
			      C 
			      C     ; If not, loop
 E62C  FE CB		      C     dec bl
 E62E  75 F0		      C     jnz short Int15h_C2_ResetMouse_TryLoop
			      C 
			      C     ; !!!!!!!!!!!!!!!!!!!!!!!!
			      C     ; Timeout occurred
			      C     ; This can only come from WaitAck so the error code and flags are in place
			      C     ; and we move to C2 exit code path
 E630  EB B4		      C     jmp short Int15h_C2_Exit
			      C 
			      C     ; At this point we got an acknowledgement to our command
 E632			      C Int15h_C2_ResetMouse_GetID:
 E632  E8 19F4		      C     call ReadAuxData_NoReturnOnError
 E635  8A D8		      C     mov bl, al  ; Store data into BX for later
			      C 
			      C ;; Hacky jump point because this call + storage + success jump is duplicated below 
 E637			      C Int15_C2_ResetMouse_ReadLastByteAndJumpOnSuccess:
 E637  E8 19EF		      C     call ReadAuxData_NoReturnOnError
 E63A  8A F8		      C     mov bh, al ; Store data into BX for later
			      C 
			      C ;; We can move BL and BH on the stack frame on demand
			      C ;; DX = 0 means DONT do that
 E63C  0B D2		      C     or dx, dx
 E63E  74 03		      C     jz short SkipWritingResultIntoBH
 E640  89 5E 0E		      C     mov Int15h_C2_BP_Offset, bx
 E643			      C SkipWritingResultIntoBH:
 E643  EB 8D		      C     jmp Int15h_C2_Success
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 2: Set Sampling Rate
			      C ; bh on stack frame = sample rate table index
			      C ; cf: 0 = no error, 1 = error
 E645			      C Int15h_C2_SetSamplingRate:
			      C     ; Check if input is valid
			      C 
 E645  80 FF 06		      C     cmp bh, 6
			      C     _JA Int15h_C2_InvalidInputError
 E648  0F 87		     1C     db 0fh, 087h
 E64A  FF8E		     1C     dw (offset Int15h_C2_InvalidInputError)-$-2
			      C 
			      C     ; Send "Set report rate" command and wait for ack
 E64C  B0 F3		      C     mov al, Cmd_SetSamplingRate
 E64E  E8 19E1		      C     call Out_8042_Aux_And_WaitAck_NoReturnOnError
			      C 
			      C     ; Read report rate from table based on index
 E651  8A DF		      C     mov bl, bh
 E653  32 FF		      C     xor bh, bh
 E655  2E: 8A 87 0050 R	      C     mov al, byte ptr cs:[bx+Int15h_C2_SampleRateTable]
			      C 
			      C     ; Send report rate to the mouse
 E65A  EB B1		      C     jmp short Int15h_C2_SendByteWaitAckAndExit
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 3: Set Resolution
			      C ; bh on stack frame = Resolution value (0-3)
			      C ; cf: 0 = no error, 1 = error
 E65C			      C Int15h_C2_SetResolution:
			      C     ; Check parameter for validity
 E65C  80 FF 03		      C     cmp bh, 3
			      C     _JA Int15h_C2_InvalidInputError
 E65F  0F 87		     1C     db 0fh, 087h
 E661  FF77		     1C     dw (offset Int15h_C2_InvalidInputError)-$-2
			      C 
			      C     ; Send "set resolution" command to the mouse and wait for ack
 E663  B0 E8		      C     mov al, Cmd_SetResolution
 E665  E8 19CA		      C     call Out_8042_Aux_And_WaitAck_NoReturnOnError
			      C 
			      C     ; Ack ok, send the resolution value
 E668  8A C7		      C     mov al, bh
 E66A  EB A1		      C     jmp short Int15h_C2_SendByteWaitAckAndExit
			      C 
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 4: Read Aux Device Type
			      C ; cf: 0 = no error, 1 = error
 E66C			      C Int15h_C2_ReadDeviceType:
			      C     ; Send "read type" command to the mouse and wait for ack
 E66C  B0 F2		      C     mov al, Cmd_ReadDeviceType
 E66E  E8 19C1		      C     call Out_8042_Aux_And_WaitAck_NoReturnOnError
			      C 
			      C     ; Ack ok, read the response
 E671  B2 01		      C     mov dl, 1 ;; Force writing result into BH
 E673  EB C2		      C     jmp short Int15_C2_ResetMouse_ReadLastByteAndJumpOnSuccess
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 5: Mouse Initialization
			      C ; bh on stack frame = packet size (1-8 bytes)
			      C ; cf: 0 = no error, 1 = error
 E675			      C Int15h_C2_MouseInit:
			      C     ; Check supplied packet size
 E675  FE CF		      C     dec bh  ;; so a zero which is invalid would become 0FFh, thus the unsigned comparison catches all
 E677  80 FF 07		      C     cmp bh, 7
			      C     _JA Int15h_C2_InvalidInputError
 E67A  0F 87		     1C     db 0fh, 087h
 E67C  FF5C		     1C     dw (offset Int15h_C2_InvalidInputError)-$-2
			      C 
 E67E  33 D2		      C     xor dx, dx ;; DX = 0 -> Do not write the result
			      C     ; The rest of the code path is so similar to ResetMouse
			      C     ; that I just decided to use it outright.
			      C     ; Close enough (tm)
 E680  EB 94		      C     jmp Int15h_C2_ResetMouse_Execute
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 6: Extended Commands
			      C ; bl on stack frame = Extended Command
			      C ;   -> 0 = return status, 1 = set scale to 1:1, 2 = set scale to 2:1
			      C ; cf: 0 = no error, 1 = error
 E682			      C Int15h_C2_ExtendedCommand:
 E682  0A FF		      C     or bh, bh
 E684  74 10		      C     jz short Int15h_C2_ExtendedCommand_GetStatus
			      C 
 E686  FE CF		      C     dec bh
			      C 
			      C     ; If it is 0 now: Int15h C2 SubFunction 6, 1: Set scaling to 1:1
 E688  B0 E6		      C     mov al, Cmd_ResetScaling
 E68A  74 07		      C     jz short Int15h_C2_ExtendedCommand_Scale21_Execute
			      C 
			      C 
			      C     ; If it is 0 now: Int15h C2 SubFunction 6, 2: Set scaling to 2:1
 E68C  40		      C     inc ax ; AL is now Cmd_SetScaling
 E68D  FE CF		      C     dec bh
			      C 
			      C     ; Also not it? Then we leave
			      C     _JNZ Int15h_C2_InvalidFunctionError
 E68F  0F 85		     1C     db 0fh, 085h
 E691  FF43		     1C     dw (offset Int15h_C2_InvalidFunctionError)-$-2
			      C 
			      C ; Execution code path for C2/6 scaling commands 0/1
 E693			      C Int15h_C2_ExtendedCommand_Scale21_Execute:
 E693  E9 FF77		      C     jmp Int15h_C2_SendByteWaitAckAndExit
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Int15h C2 SubFunction 6, 0: Get status
			      C ; The format of this is complex and I have no clue about it
			      C ; but the result is put in BL, CL and DL on the stack frame
 E696			      C Int15h_C2_ExtendedCommand_GetStatus:
			      C     ; Send status request command to aux device
 E696  B0 E9		      C     mov al, Cmd_StatusRequest
 E698  E8 1997		      C     call Out_8042_Aux_And_WaitAck_NoReturnOnError
			      C 
			      C     ; We can now theoretically read the status bytes from the mouse
			      C ;;    call ReadAuxData_NoReturnOnError
			      C ;;    mov Int15h_C2_BP_bl, al
			      C ;;    call ReadAuxData_NoReturnOnError
			      C ;;    mov Int15h_C2_BP_cl, al
			      C ;;    call ReadAuxData_NoReturnOnError
