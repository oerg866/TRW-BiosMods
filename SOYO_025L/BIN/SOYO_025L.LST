 0000			      C Int15h_C2_WaitAck:
			      C     ; Try and wait for AUX buffer to be full
 0000  E8 E6C7		      C     call Int15_C2_TryAuxFull
 0003  74 0E		      C     jz short Int15h_C2_WaitAck_GenericError
			      C     ; Check Ack Code
 0005  E4 60		      C     in al, KBC_DataPort
 0007  3C FA		      C     cmp al, KBC_Aux_Code_Ack
 0009  74 13		      C     je short Int15h_C2_WaitAck_Success
			      C     ; Check Resend Code
 000B  3C FE		      C     cmp al, KBC_Aux_Code_Resend
 000D  75 04		      C     jne short Int15h_C2_WaitAck_GenericError
			      C     ; Resend code was returned
 000F  B0 04		      C     mov al, Int15h_AH_Resend
 0011  EB 02		      C     jmp short Int15h_C2_WaitAck_Error
			      C 
			      C ;; Flags Interface Error in AL
 0013			      C Int15h_C2_WaitAck_GenericError:
