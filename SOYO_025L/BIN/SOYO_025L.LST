			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Update Code Cave location
 = E6D6			      C CODECAVE_HDDParams = $
			      C ; !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
			      C ; We put some of the external helper functions outside the HDD code cave!
			      C ; This is because else that bigass code cave is still not enough...
			      C     ORG offset CODECAVE_ROMCopyright0
			      C 
			      C ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
			      C ; Wait for AUX Command Response
			      C ; cf: 0 = No error, 1 = error
