 E6CE  E8 F243		      C     call Out_8042_Aux_Full
 E6D1  59		      C     pop cx
 E6D2  E1 F9		      C     loopz short Int15_C2_TryAuxFull_Loop
 E6D4  59		      C     pop cx
 E6D5  C3		      C     retn
