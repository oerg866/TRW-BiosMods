 = 0008			      C ITEM_Disabled EQU 1000b
			      C 
			      C UNHIDE_OPTION MACRO where
			      C     PATCH_CODE_START
			      C 
			      C     ORG offset where
			      C     dw &where&_FLAGS AND (NOT ITEM_Disabled)
			      C 
			      C     PATCH_CODE_END
			      C     ENDM
			      C 
