				    INCLUDE ..\__scripts\macros.inc
			      C ; BIOS Hacking helper macros
			      C 
			      C FAR_JMP     MACRO SEGMENT, OFFSET
			      C             DB 0EAh
			      C             dw OFFSET
			      C             dw SEGMENT
			      C             ENDM
			      C 
			      C FAR_CALL    MACRO SEGMENT, OFFSET
			      C             DB 09Ah
			      C             DW OFFSET
			      C             DW SEGMENT
			      C             ENDM
			      C 
			      C POSTCODE MACRO CODE
			      C             push ax
			      C             mov al, CODE
			      C             out 80h, al
			      C             pop ax
			      C             ENDM
			      C 
			      C MESSAGE MACRO MODULE, TEXT
			      C ;    ECHO ----------------------------------------
			      C     ECHO [ MODULE ] TEXT
			      C ;    ECHO ----------------------------------------
			      C     ENDM
			      C 
			      C PATCH_CODE_START MACRO
			      C     SEG_15 SEGMENT USE16 PARA PUBLIC 'CODE'
			      C     ENDM
			      C 
			      C PATCH_CODE_END MACRO
			      C     SEG_15 ENDS
			      C     ENDM
			      C 
			      C STRINGIFY MACRO arg
			      C     LOCAL foo
			      C     foo CATSTR <'>,arg,<'>
			      C     EXITM foo
			      C ENDM
			      C 
			      C IODELAY macro
			      C     jmp short $+2
			      C     jmp short $+2
			      C     endm
			      C 
