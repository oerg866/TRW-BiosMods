			      C ; A conditional NEAR JUMP, 386+
			      C 
			      C _JNZ    macro WHERE
			      C     db 0fh, 085h
			      C     dw (offset WHERE)-$-2
			      C     endm
			      C 
			      C _JZ    macro WHERE
			      C     db 0fh, 084h
			      C     dw (offset WHERE)-$-2
			      C     endm
			      C 
			      C _JA     macro WHERE
			      C     db 0fh, 087h
			      C     dw (offset WHERE)-$-2
			      C     endm
			      C 
